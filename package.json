{
  "name": "libflacjs",
  "version": "5.6.0",
  "main": "index.js",
  "description": "FLAC data stream encoder and decoder compiled in JavaScript using emscripten.",
  "directories": {
    "doc": "doc",
    "bin": "dist",
    "example": "example",
    "test": "tools/test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmig/libflac.js.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmig/libflac.js/issues"
  },
  "homepage": "https://github.com/mmig/libflac.js",
  "keywords": [
    "flac",
    "audio",
    "codec",
    "encode",
    "decode",
    "emscripten",
    "stream",
    "metadata"
  ],
  "typesVersions": {
      "<5.7": {
          "*": ["types-compat/ts-5.6/*"]
      },
      "<3.6": {
          "*": ["types-compat/ts-3.4/*"]
      }
  }
}