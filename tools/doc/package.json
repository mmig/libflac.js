{
  "name": "libflacjs-doc",
  "version": "0.3.0",
  "description": "API doc generation for libFLAC.js",
  "keywords": [
    "documentation",
    "mmir"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmig/libflacjs"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.1",
    "@types/gulp": "^4.0.18",
    "@types/webpack": "^5.28.5",
    "del": "^6.1.1",
    "downlevel-dts": "file:../../../downlevel-dts",
    "fs-extra": "^9.0.1",
    "gulp": "^5.0.1",
    "gulp-jsdoc3": "^3.0.0",
    "jaguarjs-jsdoc": "git+https://github.com/mmig/jaguarjs-jsdoc.git#patched",
    "jsdoc": "^4.0.5"
  },
  "scripts": {
    "build": "gulp jsdoc_and_ts",
    "doc": "gulp",
    "doc:json": "gulp jsdoc_and_json",
    "doc:all": "gulp jsdoc_all",
    "doc:clean": "gulp clean_jsdoc",
    "build:ts": "gulp ts_all",
    "build:typings": "gulp gen_typings",
    "build:utils": "gulp build_ts_utils",
    "build:example": "gulp build_ts_example",
    "build:clean": "gulp clean_ts_utils",
    "downlevel-dts": "npm run downlevel-dts:dist && npm run downlevel-dts:lib",
    "downlevel-dts:dist": "downlevel-dts ../../dist ../../types-compat/ts-{VERSION}/dist --to=3.4,5.6",
    "downlevel-dts:lib": "downlevel-dts ../../lib ../../types-compat/ts-{VERSION}/lib --to=3.4,5.6"
  }
}
